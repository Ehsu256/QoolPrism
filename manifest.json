{
  "manifest_version": 3,
  "name": "QoolPrism",
  "short_name": "QP",
  "version": "1.0",
  "description": "Additional UI features for PhotoPrism. (https://github.com/photoprism/photoprism)",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "QoolPrism",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  }
}
